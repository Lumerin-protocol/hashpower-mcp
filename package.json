{
  "name": "@hashpower/mcp",
  "version": "0.1.0",
  "description": "Hashpower MCP server: knowledge base and simulator for agentic trading. Not a trading intermediary — agents sign and send their own transactions.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "hashpower-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lumerin-protocol/hashpower-mcp.git"
  },
  "keywords": [
    "hashpower",
    "mcp",
    "agent",
    "base",
    "hashprice"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:http": "HASHPOWER_TRANSPORT=http node dist/index.js",
    "test": "tsx --test tests/*.test.ts",
    "lint": "biome lint src/ tests/",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hashpower/collateral-abi": "^0.2.0",
    "@hashpower/futures-abi": "^0.4.0",
    "@hashpower/oracle-abi": "^0.1.0",
    "@hashpower/perps-abi": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "viem": "^2.37.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
